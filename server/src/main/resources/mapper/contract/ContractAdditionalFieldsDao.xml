<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.contract.dao.ContractAdditionalFieldsDao">

    <resultMap id="BaseResultMap" type="com.sqx.modules.contract.entity.ContractAdditionalFields">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="contractId" column="contract_id" jdbcType="INTEGER"/>
            <result property="listedName" column="listed_name" jdbcType="VARCHAR"/>
            <result property="columnComment" column="column_comment" jdbcType="VARCHAR"/>
            <result property="sort" column="sort" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,contract_id,listed_name,
        column_comment,sort,create_time,
    </sql>
    <insert id="insertBatch">
        insert into contract_additional_fields
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="additionalFields" item="dataJsonVo" index="index" separator=",">
                    id,
                    contract_id,
                    listed_name,
                    column_comment,
                    sort,
                    create_time
                </foreach>
        </trim>
                    values
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="additionalFields" item="dataJsonVo" index="index" separator=",">
                    #{dataJsonVo.id},
                    #{dataJsonVo.contractId},
                    #{dataJsonVo.listedName},
                    #{dataJsonVo.columnComment},
                    #{dataJsonVo.sort},
                    #{dataJsonVo.createTime}
                </foreach>
        </trim>
    </insert>
    <select id="selectByContractId" resultType="com.sqx.modules.contract.entity.ContractAdditionalFields">
        select
        <include refid="Base_Column_List"/>
        from contract_additional_fields
        where contract_id = #{contractId}
        order by create_time desc
    </select>
</mapper>
