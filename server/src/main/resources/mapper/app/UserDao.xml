    <select id="takingOrdersMessage" resultType="com.sqx.modules.app.response.TakingOrderResponse">
        SELECT
        SUM( o.order_number ) AS orderNumber,
        g.game_name,
        SUM( o.pay_money ) AS payMoney
        FROM
        ( orders o LEFT JOIN order_taking t ON o.order_taking_id = t.id )
        LEFT JOIN game g ON g.id = t.game_id
        WHERE
        o.state = 1
        <if test="type==1">
            and date_format("o.create_time",'%y-%M-%d')=date_format(#{date},'%y-%M-%d')
        </if>
        <if test="type==2">
            and date_format("o.create_time",'%y-%M-%d')=date_format(#{date},'%y-%M-%d')
        </if>
        <if test="type==3">
            and date_format("o.create_time",'%y-%M-%d')=date_format(#{date},'%y-%M-%d')
        </if>

        GROUP BY
        g.game_name
    </select>


    <select id="selectUserByUserId" resultType="com.sqx.modules.app.entity.UserEntity">
        select * from tb_user
        where user_id=#{userId}
    </select>
    <select id="getAuthExtensionList" resultType="com.sqx.modules.app.entity.UserEntity">
        select u.*,uc.status as status1
        from tb_user u
        left join user_certification uc on uc.user_id=u.user_id
        where u.is_authentication=1 and uc.status=1 and u.inviter_code=#{invitationCode}
        order by u.create_time desc
    </select>
    <select id="getUserIncomeList" resultType="java.util.HashMap">
        select u.user_name as userName,
        u.avatar as avatar,
        u.user_id as userId,
        (SELECT IFNULL(SUM(money),0) FROM `user_money_details` m WHERE m.relation_id = u.user_id
        <if test="type==1">
            AND m.user_level = 1
        </if>
        <if test="type==2">
            AND m.user_level = 2
        </if>
        )AS money
        FROM
        tb_user u,
        tb_user ua
        WHERE 1 = 1
        <if test="type==1">
            and u.inviter_code = ua.invitation_code
        </if>
        <if test="type==2">
            and u.inviter_inviter_code = ua.invitation_code
        </if>
        and ua.user_id = #{userId}
        order by money desc
    </select>


